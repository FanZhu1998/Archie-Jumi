{
  "name": "archie-jumi",
  "productName": "Archie & Jumi",
  "version": "1.1.0",
  "description": "Two little companions for your desktop",
  "author": "Archie & Jumi",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && node scripts/run-electron.mjs .",
    "preview": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "smoke": "npm run build && node scripts/run-electron.mjs . --smoke-test",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "art": "node scripts/generate-art.mjs"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@playwright/test": "1.64.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.8.0",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.4": true
  }
}
